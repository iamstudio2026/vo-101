# Only public, non-secret values belong here: every VITE_* variable is compiled into
# the browser bundle. Model keys live in vo101-engine, never in this app.

# Base URL of vo101-engine's user API. Default "/engine" = proxied by this app's nginx.
VITE_ENGINE_URL=
# Google Drive picker (public OAuth client id and browser key, restricted by referrer)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
